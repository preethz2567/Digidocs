.stats-card {
  background-color: var(--bg-color, #ffffff);
  border: 1px solid var(--border-color);
  border-radius: var(--radius-lg);
  padding: var(--space-5);
  display: flex;
  flex-direction: column;
  gap: var(--space-3);
  transition: box-shadow 150ms ease, transform 150ms ease;
}

.stats-card:hover {
  box-shadow: var(--shadow-md);
}

.stats-card__header {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.stats-card__title {
  font-size: 13px;
  font-weight: 500;
  color: var(--text-secondary);
}

.stats-card__icon {
  width: 20px;
  height: 20px;
  color: var(--text-secondary);
  opacity: 0.7;
}

.stats-card__content {
  display: flex;
  align-items: baseline;
  gap: var(--space-3);
}

.stats-card__value {
  font-size: 28px;
  font-weight: 600;
  color: var(--text-primary);
  letter-spacing: -0.02em;
}

.stats-card__trend {
  display: flex;
  align-items: center;
  gap: var(--space-1);
  font-size: 12px;
  font-weight: 500;
}

.trend-up {
  color: var(--success-color, #16A34A);
}

.trend-down {
  color: var(--text-secondary);
}
